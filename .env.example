# Set to 'true' to use mock/demo data instead of connecting to real nodes
DEMO_MODE=false

# Node addresses: host:port (http), https://host:port, [IPv6]:port or https://[IPv6]:port.
# With a scheme the port may be left out: https://host is port 443, http://host port 80.
STORJ_NODES_JSON='[
  {"host":"storj-node-1.example:14067"},
  {"host":"https://storj-node-2.example:443"},
  {"host":"[fd00::14]:14002"}
]'

# Prefer https:// for Sia nodes outside your network: the password is sent as HTTP Basic auth.
SIA_NODES_JSON='[
  {"host":"https://sia-host-1.example:443","password":"change-me"},
  {"host":"sia-host-2.example:9980","username":"sia-user","password":"change-me","walletHost":"sia-wallet-2.example:9980"}
]'

# Optional: time limit per node request in milliseconds (default 30000).
# NODE_REQUEST_TIMEOUT_MS=30000

# Optional: dashboard port (default 3000).
# PORT=3000

# Optional: serve the dashboard over https (set both, PEM files).
# TLS_CERT_FILE=/path/to/dashboard-cert.pem
# TLS_KEY_FILE=/path/to/dashboard-key.pem

# A private CA or self-signed certificate of an https node: start the server with
# NODE_EXTRA_CA_CERTS=/path/to/node-ca.pem in its environment (Node.js reads it at startup,
# so it cannot be set in this file).

# Legacy fallback compatibility:
# STORJ_HOSTS=storj-node-1.example:14067,storj-node-2.example:14068
# SIA_HOSTS=sia-host-1.example:9980,sia-host-2.example:9985
# SIA_USERNAME=
# SIA_PASSWORD=
# SIA_WALLET_HOST=
